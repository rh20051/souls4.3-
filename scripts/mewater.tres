code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, world_vertex_coords;

uniform sampler2D tex_vtx_4;
uniform vec4 ColorParameter : source_color = vec4(0.018666, 0.254060, 0.504226, 1.000000);
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_13;
uniform vec4 ColorParameter2 : source_color = vec4(0.018666, 0.254060, 0.504226, 1.000000);
uniform sampler2D tex_frg_31;
uniform sampler2D depth_tex_frg_18 : hint_depth_texture;



void vertex() {
// Input:2
	float n_out2p0 = TIME;


// UVFunc:3
	vec2 n_in3p1 = vec2(0.10000, 0.10000);
	vec2 n_out3p0 = vec2(n_out2p0) * n_in3p1 + UV;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_vtx_4, n_out3p0);


// Input:6
	vec3 n_out6p0 = NORMAL;


// VectorOp:8
	vec3 n_in8p1 = vec3(0.20000, 0.20000, 0.20000);
	vec3 n_out8p0 = n_out6p0 * n_in8p1;


// Input:5
	vec3 n_out5p0 = VERTEX;


// MultiplyAdd:7
	vec4 n_out7p0 = fma(n_out4p0, vec4(n_out8p0, 0.0), vec4(n_out5p0, 0.0));


// Output:0
	VERTEX = vec3(n_out7p0.xyz);


}

void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = ColorParameter;


// UVFunc:36
	vec2 n_in36p1 = vec2(80.00000, 80.00000);
	vec2 n_in36p2 = vec2(0.00000, 0.00000);
	vec2 n_out36p0 = (UV - n_in36p2) * n_in36p1 + n_in36p2;


// Input:6
	float n_out6p0 = TIME;


// UVFunc:5
	vec2 n_in5p1 = vec2(0.10000, 0.10000);
	vec2 n_out5p0 = vec2(n_out6p0) * n_in5p1 + n_out36p0;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out5p0);


// UVFunc:35
	vec2 n_in35p1 = vec2(80.00000, 80.00000);
	vec2 n_in35p2 = vec2(0.00000, 0.00000);
	vec2 n_out35p0 = (UV - n_in35p2) * n_in35p1 + n_in35p2;


// Input:11
	float n_out11p0 = TIME;


// UVFunc:12
	vec2 n_in12p1 = vec2(-0.10000, -0.10000);
	vec2 n_out12p0 = vec2(n_out11p0) * n_in12p1 + n_out35p0;


// Texture2D:13
	vec4 n_out13p0 = texture(tex_frg_13, n_out12p0);


// VectorOp:14
	vec4 n_out14p0 = n_out2p0 * n_out13p0;


// VectorOp:15
	vec4 n_in15p1 = vec4(1.25000, 1.25000, 1.25000, 1.25000);
	vec4 n_out15p0 = pow(n_out14p0, n_in15p1);


// VectorOp:3
	vec4 n_out3p0 = n_out4p0 + n_out15p0;


// VectorOp:20
	vec3 n_in20p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out20p0 = vec3(n_out3p0.xyz) + n_in20p1;


// ColorParameter:32
	vec4 n_out32p0 = ColorParameter2;


// Texture2D:31
	vec4 n_out31p0 = texture(tex_frg_31, UV);


// VectorOp:33
	vec4 n_out33p0 = n_out32p0 + n_out31p0;


// FloatOp:28
	float n_out28p0 = n_out33p0.x * n_out31p0.x;


// FloatFunc:21
	float n_out21p0 = sin(n_out28p0);


// FloatFunc:24
	float n_out24p0 = abs(n_out21p0);


	float n_out18p0;
// ProximityFade:18
	float n_in18p0 = 0.50000;
	{
		float __depth_tex = texture(depth_tex_frg_18, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out18p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in18p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatFunc:19
	float n_out19p0 = 1.0 - n_out18p0;


// FloatOp:25
	float n_out25p0 = n_out24p0 * n_out19p0;


// FloatOp:26
	float n_in26p1 = 24.00000;
	float n_out26p0 = pow(n_out19p0, n_in26p1);


// FloatOp:27
	float n_out27p0 = n_out25p0 + n_out26p0;


// Mix:30
	vec3 n_in30p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out30p0 = mix(n_out20p0, n_in30p1, vec3(n_out27p0));


// DistanceFade:38
	float n_in38p0 = 0.00000;
	float n_in38p1 = 20.00000;
	float n_out38p0 = clamp(smoothstep(n_in38p0, n_in38p1, length(VERTEX)), 0.0, 1.0);


// FloatConstant:17
	float n_out17p0 = 0.000000;


// Output:0
	ALBEDO = n_out30p0;
	ALPHA = n_out38p0;
	ROUGHNESS = n_out17p0;
	EMISSION = vec3(n_out15p0.xyz);


}
