code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert_wrap, specular_toon;

uniform sampler2D tex_frg_7;
uniform vec2 scale;
uniform sampler2D tex_frg_8 : source_color;
uniform vec3 color;



void fragment() {
	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = vec4(0.0);


// Texture2D:7
	vec4 n_out7p0 = textureLod(tex_frg_7, UV, n_out10p0.x);


// Vector2Parameter:13
	vec2 n_out13p0 = scale;


// UVFunc:5
	vec2 n_in5p2 = vec2(0.00000, 0.00000);
	vec2 n_out5p0 = (UV - n_in5p2) * n_out13p0 + n_in5p2;


	vec4 n_out9p0;
// Texture2D:9
	n_out9p0 = vec4(0.0);


// Texture2D:8
	vec4 n_out8p0 = textureLod(tex_frg_8, n_out5p0, n_out9p0.x);


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out7p0.xyz) * vec3(n_out8p0.xyz);


// Vector3Parameter:15
	vec3 n_out15p0 = color;


// ColorOp:14
	vec3 n_out14p0 = vec3(1.0) - (vec3(1.0) - n_out12p0) * (vec3(1.0) - n_out15p0);


// Output:0
	ALBEDO = n_out14p0;


}
