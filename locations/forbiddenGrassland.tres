code = "shader_type spatial;
render_mode blend_mix, depth_draw_always, cull_disabled, diffuse_lambert, specular_disabled, ensure_correct_normals, vertex_lighting;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_7;
uniform sampler2D tex_frg_23;



void fragment() {
// Input:16
	mat4 n_out16p0 = VIEW_MATRIX;


// Input:6
	vec3 n_out6p0 = NORMAL;


// TransformVectorMult:15
	vec3 n_out15p0 = (vec4(n_out6p0, 1.0) * n_out16p0).xyz;


// Vector3Constant:12
	vec3 n_out12p0 = vec3(0.000000, 1.000000, 0.000000);


// DotProduct:13
	float n_out13p0 = dot(n_out15p0, n_out12p0);


// UVFunc:4
	vec2 n_in4p1 = vec2(60.00000, 60.87000);
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = (UV - n_in4p2) * n_in4p1 + n_in4p2;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out4p0);


// UVFunc:9
	vec2 n_in9p1 = vec2(60.00000, 60.00000);
	vec2 n_in9p2 = vec2(0.00000, 0.00000);
	vec2 n_out9p0 = (UV - n_in9p2) * n_in9p1 + n_in9p2;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, n_out9p0);


// FloatOp:20
	float n_in20p1 = 0.70000;
	float n_out20p0 = n_out13p0 - n_in20p1;


// FloatOp:21
	float n_in21p1 = 4.00000;
	float n_out21p0 = n_out20p0 * n_in21p1;


// Mix:18
	vec3 n_out18p0 = mix(vec3(n_out7p0.xyz), vec3(n_out2p0.xyz), n_out21p0);


	vec3 n_out19p0;
// If:19
	float n_in19p1 = 0.70000;
	float n_in19p2 = 0.00001;
	if(abs(n_out13p0 - n_in19p1) < n_in19p2)
	{
		n_out19p0 = n_out18p0;
	}
	else if(n_out13p0 < n_in19p1)
	{
		n_out19p0 = vec3(n_out7p0.xyz);
	}
	else
	{
		n_out19p0 = n_out18p0;
	}


	vec3 n_out14p0;
// If:14
	float n_in14p1 = 0.95000;
	float n_in14p2 = 0.00001;
	if(abs(n_out13p0 - n_in14p1) < n_in14p2)
	{
		n_out14p0 = vec3(n_out2p0.xyz);
	}
	else if(n_out13p0 < n_in14p1)
	{
		n_out14p0 = n_out19p0;
	}
	else
	{
		n_out14p0 = vec3(n_out2p0.xyz);
	}


// Texture2D:23
	vec4 n_out23p0 = texture(tex_frg_23, UV);


	vec3 n_out22p0;
// ColorOp:22
	{
		float base = n_out14p0.x;
		float blend = vec3(n_out23p0.xyz).x;
		if (base < 0.5) {
			n_out22p0.x = 2.0 * base * blend;
		} else {
			n_out22p0.x = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = n_out14p0.y;
		float blend = vec3(n_out23p0.xyz).y;
		if (base < 0.5) {
			n_out22p0.y = 2.0 * base * blend;
		} else {
			n_out22p0.y = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = n_out14p0.z;
		float blend = vec3(n_out23p0.xyz).z;
		if (base < 0.5) {
			n_out22p0.z = 2.0 * base * blend;
		} else {
			n_out22p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


// Output:0
	ALBEDO = n_out22p0;


}
