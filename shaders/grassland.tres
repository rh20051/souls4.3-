code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;




void fragment() {
// Input:8
	mat4 n_out8p0 = VIEW_MATRIX;


// Input:2
	vec3 n_out2p0 = NORMAL;


// TransformVectorMult:9
	vec3 n_out9p0 = (vec4(n_out2p0, 1.0) * n_out8p0).xyz;


// DotProduct:3
	vec3 n_in3p1 = vec3(0.00000, 0.00000, 0.00000);
	float n_out3p0 = dot(n_out9p0, n_in3p1);


// ColorConstant:6
	vec4 n_out6p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


// ColorConstant:5
	vec4 n_out5p0 = vec4(0.550000, 0.550000, 0.341000, 1.000000);


// Mix:10
	vec4 n_in10p2 = vec4(1.40000, 1.40000, 1.40000, 1.40000);
	vec4 n_out10p0 = mix(n_out6p0, n_out5p0, n_in10p2);


	vec3 n_out11p0;
// If:11
	float n_in11p1 = 0.02000;
	float n_in11p2 = 0.00001;
	if(abs(n_out3p0 - n_in11p1) < n_in11p2)
	{
		n_out11p0 = vec3(n_out5p0.xyz);
	}
	else if(n_out3p0 < n_in11p1)
	{
		n_out11p0 = vec3(n_out10p0.xyz);
	}
	else
	{
		n_out11p0 = vec3(n_out10p0.xyz);
	}


	vec3 n_out7p0;
// If:7
	float n_in7p1 = 4.14500;
	float n_in7p2 = 0.00000;
	if(abs(n_out3p0 - n_in7p1) < n_in7p2)
	{
		n_out7p0 = vec3(n_out6p0.xyz);
	}
	else if(n_out3p0 < n_in7p1)
	{
		n_out7p0 = n_out11p0;
	}
	else
	{
		n_out7p0 = vec3(n_out5p0.xyz);
	}


// Output:0
	ALBEDO = n_out7p0;


}
